{
    "dashboard": {
      "id": null,
      "title": "个人博客 - 系统资源监控",
      "tags": ["system", "node-exporter"],
      "panels": [
        {
          "title": "CPU使用率",
          "type": "graph",
          "targets": [
            {
              "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
              "legendFormat": "CPU使用率%"
            }
          ]
        },
        {
          "title": "内存使用率",
          "type": "graph",
          "targets": [
            {
              "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
              "legendFormat": "内存使用率%"
            }
          ]
        },
        {
          "title": "磁盘使用率",
          "type": "graph",
          "targets": [
            {
              "expr": "100 - ((node_filesystem_avail_bytes * 100) / node_filesystem_size_bytes)",
              "legendFormat": "磁盘使用率%"
            }
          ]
        }
      ]
    }
  }