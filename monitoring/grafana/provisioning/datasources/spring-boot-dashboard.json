{
    "dashboard": {
      "id": null,
      "title": "个人博客 - Spring Boot监控",
      "tags": ["spring-boot", "personal-blog"],
      "timezone": "browser",
      "panels": [
        {
          "title": "应用状态",
          "type": "stat",
          "targets": [
            {
              "expr": "up{job=\"spring-boot-blog\"}",
              "legendFormat": "应用状态"
            }
          ]
        },
        {
          "title": "JVM内存使用",
          "type": "graph",
          "targets": [
            {
              "expr": "jvm_memory_used_bytes{job=\"spring-boot-blog\"}",
              "legendFormat": "已用内存"
            },
            {
              "expr": "jvm_memory_max_bytes{job=\"spring-boot-blog\"}",
              "legendFormat": "最大内存"
            }
          ]
        },
        {
          "title": "HTTP请求数",
          "type": "graph",
          "targets": [
            {
              "expr": "rate(http_server_requests_seconds_count{job=\"spring-boot-blog\"}[5m])",
              "legendFormat": "请求/秒"
            }
          ]
        }
      ],
      "time": {
        "from": "now-1h",
        "to": "now"
      },
      "refresh": "5s"
    }
  }